---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RecipeList from '../components/RecipeList.astro';
import Search from '../components/Search.astro';
import { groupByCategory } from '../lib/recipes';

const recipes = await getCollection('recipes');
const groups = groupByCategory(recipes);
---
<Base>
  <h1 class="sr-only">Recepty</h1>
  <Search recipes={recipes} />
  {groups.length === 0 && <p>Zatím žádné recepty.</p>}
  {
    groups.map((g) => (
      <section data-group class="mt-8 first:mt-0">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
          <a href={`/kategorie/${g.key}/`} class="hover:underline">
            {g.label}
          </a>
        </h2>
        <RecipeList recipes={g.recipes} />
      </section>
    ))
  }
  <p id="search-empty" hidden class="mt-8 text-zinc-500 dark:text-zinc-400">Nic nenalezeno.</p>
</Base>
