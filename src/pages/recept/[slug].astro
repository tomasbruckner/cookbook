---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import { categoryLabel } from '../../consts';
import { splitIngredients } from '../../lib/sections';
import { formatMinutes, formatServings } from '../../lib/format';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const { title, category, tags, servings, time, source } = recipe.data;
const { before, ingredients, after } = splitIngredients(recipe.body ?? '');
const prose =
  'prose prose-zinc prose-lg max-w-none dark:prose-invert prose-a:text-[var(--color-accent)] prose-a:break-words';
---
<Base title={title}>
  <article>
    <header class="mb-6">
      <h1 class="text-3xl font-bold sm:text-4xl">{title}</h1>
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-zinc-600 dark:text-zinc-400">
        <a href={`/kategorie/${category}/`} class="hover:underline">{categoryLabel(category)}</a>
        {time !== undefined && <span>Čas: {formatMinutes(time)}</span>}
        {servings !== undefined && <span>{formatServings(servings)}</span>}
        {source && <span>Zdroj: {source}</span>}
      </p>
      {tags.length > 0 && (
        <div class="mt-3">
          <TagList tags={tags} />
        </div>
      )}
    </header>

    {before.trim() && <div class={prose} set:html={renderMarkdown(before)} />}

    {
      ingredients !== null && (
        <div class="mt-6 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10">
          <div data-section="ingredients" class={`${prose} lg:sticky lg:top-4 lg:self-start lg:max-h-[calc(100dvh-2rem)] lg:overflow-y-auto`} set:html={renderMarkdown(ingredients)} />
          <div data-section="rest" class={prose} set:html={renderMarkdown(after)} />
        </div>
      )
    }
  </article>
</Base>

<script>
  // Click-to-load: YouTube se načte až po klepnutí na náhled.
  document.querySelectorAll<HTMLElement>('[data-youtube-id]').forEach((figure) => {
    const thumb = figure.querySelector<HTMLAnchorElement>('.yt-thumb');
    if (!thumb) return;
    thumb.addEventListener('click', (event) => {
      event.preventDefault();
      const start = figure.dataset.start ? `&start=${figure.dataset.start}` : '';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${figure.dataset.youtubeId}?autoplay=1${start}`;
      iframe.title = 'Video k receptu';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'aspect-video w-full rounded-lg';
      thumb.replaceWith(iframe);
    });
  });
</script>